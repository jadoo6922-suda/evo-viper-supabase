# Supabase browser configuration (publishable/anon key only; never use service_role here)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Required by protected server routes; server-only, never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional for Gemini-powered receipt OCR. Set this in Render environment variables.
GEMINI_API_KEY=

# Canonical public URL of the same deployed app. No trailing slash.
PUBLIC_APP_URL=https://YOUR_RENDER_SERVICE.onrender.com
APP_URL=

# Secret key for cryptographically signing receipts and transaction hashes (at least 32 random characters)
RECEIPT_HMAC_SECRET=

# One-time bootstrap secret; remove from Render after creating the first super-admin
BOOTSTRAP_SECRET=
# Set true only during initial production setup, then remove this variable.
ALLOW_BOOTSTRAP_IN_PRODUCTION=false

# Random secret (at least 32 characters) for the optional daily scheduler endpoint.
ADMIN_GATE_CRON_SECRET=

# Admin daily gate recipient (must be active admin/super_admin in store_profiles)
ADMIN_GATE_EMAIL=jadoo6922@gmail.com

# Shared distributed rate limiting (Upstash Redis REST); configure in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REQUIRE_DISTRIBUTED_RATE_LIMIT=true

# Telegram bot token used only on the server to verify Telegram Login Widget signatures
TELEGRAM_BOT_TOKEN=

